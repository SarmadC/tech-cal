{
  "name": "kurecal-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "doctor": "node ./scripts/run-expo-doctor.mjs",
    "build:preview": "APP_VARIANT=development npx eas-cli build --profile preview --non-interactive",
    "build:production": "APP_VARIANT=production npx eas-cli build --profile production --non-interactive",
    "eas-build-pre-install": "node ./scripts/validate-production-env.mjs",
    "ios": "APP_VARIANT=development expo run:ios",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --platform ios --clean",
    "verify:production-bundle": "APP_VARIANT=production node ./scripts/verify-production-bundle.mjs",
    "verify:production-env": "APP_VARIANT=production node ./scripts/validate-production-env.mjs",
    "verify:ios-release": "node ./scripts/verify-ios-release.mjs",
    "configure:ios-submit": "node ./scripts/configure-ios-submit.mjs",
    "release:check": "npm run doctor && npm run verify:production-bundle && npm run verify:ios-release",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-calendar": "~55.0.17",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-purchases": "^9.15.1",
    "react-native-purchases-ui": "^9.15.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.2.7",
    "babel-preset-expo": "~55.0.13",
    "expo-doctor": "^1.18.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@ungap/structured-clone": "^1.3.1",
    "js-yaml": "^4.2.0",
    "brace-expansion": "^1.1.14"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
