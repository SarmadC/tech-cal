{
  "name": "tech-cal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:scoring": "vitest run src/lib/__tests__/alignmentCore.parity.test.ts src/app/api/__tests__/filtered.contract.test.ts src/services/recommendations/__tests__/rerankAdvanced.test.ts",
    "bench:scoring": "tsx scripts/benchmark-scoring.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "type-check": "tsc --noEmit",
    "type-check:src": "tsc --noEmit -p tsconfig.src.json",
    "type-check:mobile": "npm --prefix apps/mobile run type-check",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "build:analyze": "ANALYZE=true npm run build",
    "analyze-recommendations": "tsx scripts/analyze-recommendation-data.ts",
    "analyze-ingestion": "tsx scripts/analyze-ingestion-data.ts",
    "verify-ingestion": "tsx scripts/verify-ingestion-setup.ts",
    "test-retry": "tsx scripts/test-retry-mechanism.ts",
    "ingest": "tsx scripts/run-ingestion.ts",
    "check-retry-metadata": "tsx scripts/check-retry-metadata.ts",
    "community:seed": "tsx scripts/seed-community-showcase.ts",
    "community:clear": "tsx scripts/clear-community-showcase.ts",
    "backfill:hackathon-features": "tsx scripts/backfill-hackathon-recommendation-features.ts",
    "identify-earnings": "tsx scripts/identify-earnings-events.ts",
    "fix-techmeme-urls": "tsx scripts/fix-techmeme-urls.ts",
    "normalize": "tsx scripts/run-normalization.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "test:budget": "tsx scripts/test-budget-filtering.ts",
    "validate:analytics": "tsx scripts/validate-analytics.ts",
    "verify:paddle": "tsx scripts/verify-paddle-setup.ts",
    "verify:all": "npm run verify:production && npm run test:budget && npm run validate:analytics",
    "test:domain:contracts": "npm exec vitest run packages/domain/src/eventSubmission.test.ts packages/domain/src/socialProfile.test.ts",
    "test:mobile:contracts": "npm exec vitest run apps/mobile/src/lib/env.test.ts apps/mobile/src/lib/eventSubmission.test.ts src/app/api/events/submit/route.test.ts src/app/api/profile/social/route.test.ts",
    "mobile:ci": "npm run type-check:src && npm run test:domain:contracts && npm run test:mobile:contracts && npm run type-check:mobile && npm --prefix apps/mobile run doctor"
  },
