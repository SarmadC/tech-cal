{
  "name": "tech-cal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest run",
    "test:scoring": "vitest run src/lib/__tests__/alignmentCore.parity.test.ts src/app/api/__tests__/filtered.contract.test.ts src/services/recommendations/__tests__/rerankAdvanced.test.ts",
    "bench:scoring": "tsx scripts/benchmark-scoring.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "type-check": "tsc --noEmit",
    "type-check:src": "tsc --noEmit -p tsconfig.src.json",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "build:analyze": "ANALYZE=true npm run build",
    "analyze-recommendations": "tsx scripts/analyze-recommendation-data.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "test:budget": "tsx scripts/test-budget-filtering.ts",
    "validate:analytics": "tsx scripts/validate-analytics.ts",
    "verify:all": "npm run verify:production && npm run test:budget && npm run validate:analytics"
  },
