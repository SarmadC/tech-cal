    "verify-find-similar": "tsx scripts/verify-find-similar-events-fix.ts",
    "check-retry-metadata": "tsx scripts/check-retry-metadata.ts",
    "identify-earnings": "tsx scripts/identify-earnings-events.ts",
    "fix-techmeme-urls": "tsx scripts/fix-techmeme-urls.ts",
    "link-duplicates": "tsx scripts/link-duplicate-by-url.ts",
    "normalize": "tsx scripts/run-normalization.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "test:budget": "tsx scripts/test-budget-filtering.ts",
    "validate:analytics": "tsx scripts/validate-analytics.ts",
    "verify:paddle": "tsx scripts/verify-paddle-setup.ts",
    "verify:all": "npm run verify:production && npm run test:budget && npm run validate:analytics"
  },
